generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  PARENT
  ADMIN
}

enum ApplicationStatus {
  SUBMITTED
  UNDER_REVIEW
  TOUR_SCHEDULED
  ACCEPTED
  WAITLISTED
  DECLINED
  WITHDRAWN
}

enum DocumentType {
  IMMUNIZATION_RECORD
  HEALTH_FORM
  EMERGENCY_CONTACT
  PHOTO_RELEASE
  OTHER
}

enum DocumentStatus {
  UPLOADED
  VERIFIED
  REJECTED
}

enum EnrollmentStatus {
  PENDING
  ACTIVE
  ENDED
}

enum InvoiceStatus {
  DRAFT
  OPEN
  PROCESSING
  PAID
  PARTIALLY_PAID
  VOID
  UNCOLLECTIBLE
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  CANCELED
  REFUNDED
}

enum PaymentMethodType {
  CARD
}

enum InviteStatus {
  PENDING
  ACCEPTED
  EXPIRED
  REVOKED
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  passwordHash  String?
  role          UserRole  @default(PARENT)
  householdId   String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  household         Household?                   @relation("PrimaryHousehold", fields: [householdId], references: [id], onDelete: SetNull)
  accounts          Account[]
  sessions          Session[]
  memberships       HouseholdMember[]
  applications      EnrollmentApplication[]      @relation("ApplicationParent")
  uploadedDocuments EnrollmentDocument[]         @relation("DocumentUploader")
  applicationEvents EnrollmentApplicationEvent[] @relation("ApplicationActor")
  createdInvoices   Invoice[]                    @relation("InvoiceCreator")
  paymentMethods    PaymentMethod[]              @relation("PaymentMethodCreator")
  payments          Payment[]                    @relation("PaymentActor")
  invitesSent       AdminInvite[]                @relation("InviteSender")
  auditLogs         AuditLog[]                   @relation("AuditActor")

  @@index([householdId])
  @@index([role])
}

model Household {
  id               String   @id @default(cuid())
  name             String
  billingEmail     String?
  phone            String?
  stripeCustomerId String?  @unique
  autopayEnabled   Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  primaryUsers  User[]                 @relation("PrimaryHousehold")
  members       HouseholdMember[]
  children      Child[]
  applications  EnrollmentApplication[]
  enrollments   Enrollment[]
  invoices      Invoice[]
  paymentMethods PaymentMethod[]
  payments      Payment[]
}

model HouseholdMember {
  id           String   @id @default(cuid())
  householdId  String
  userId       String
  relationship String
  isPrimary    Boolean  @default(false)
  createdAt    DateTime @default(now())

  household Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([householdId, userId])
  @@index([userId])
}

model Child {
  id               String   @id @default(cuid())
  householdId      String
  firstName        String
  lastName         String
  birthDate        DateTime
  startDate        DateTime?
  allergies        String?
  medicalNotes     String?
  emergencyNotes   String?
  authorizedPickup Json?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  household   Household    @relation(fields: [householdId], references: [id], onDelete: Cascade)
  enrollments Enrollment[]

  @@index([householdId])
}

model TuitionPlan {
  id              String   @id @default(cuid())
  slug            String   @unique
  name            String
  description     String?
  weeklyRateCents Int
  monthlyRateCents Int
  depositWeeks    Int      @default(2)
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  enrollments    Enrollment[]
  invoiceLineItems InvoiceLineItem[]
}

model EnrollmentApplication {
  id                    String            @id @default(cuid())
  parentUserId          String
  householdId           String
  status                ApplicationStatus @default(SUBMITTED)
  primaryContactName    String
  primaryContactEmail   String
  primaryContactPhone   String
  secondaryContactName  String?
  secondaryContactPhone String?
  childFirstName        String
  childLastName         String
  childBirthDate        DateTime
  desiredProgramSlug    String
  desiredStartDate      DateTime
  careSchedule          String?
  tourPreference        String?
  allergies             String?
  medicalNotes          String?
  emergencyContacts     Json
  consentPolicies       Boolean
  consentPhoto          Boolean
  additionalNotes       String?
  reviewNote            String?
  submittedAt           DateTime          @default(now())
  reviewedAt            DateTime?
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt

  parentUser User                         @relation("ApplicationParent", fields: [parentUserId], references: [id], onDelete: Cascade)
  household  Household                    @relation(fields: [householdId], references: [id], onDelete: Cascade)
  documents  EnrollmentDocument[]
  events     EnrollmentApplicationEvent[]
  enrollment Enrollment?                  @relation("EnrollmentSource")
  invoices   Invoice[]

  @@index([parentUserId])
  @@index([householdId, status])
  @@index([submittedAt])
}

model EnrollmentDocument {
  id               String         @id @default(cuid())
  applicationId    String
  uploadedByUserId String
  blobUrl          String
  blobPath         String
  fileName         String
  mimeType         String
  sizeBytes        Int
  type             DocumentType   @default(OTHER)
  status           DocumentStatus @default(UPLOADED)
  uploadedAt       DateTime       @default(now())
  reviewedAt       DateTime?
  createdAt        DateTime       @default(now())

  application EnrollmentApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  uploadedBy  User                  @relation("DocumentUploader", fields: [uploadedByUserId], references: [id], onDelete: Cascade)

  @@index([applicationId])
  @@index([uploadedByUserId])
}

model EnrollmentApplicationEvent {
  id            String            @id @default(cuid())
  applicationId String
  actorUserId   String?
  status        ApplicationStatus?
  title         String
  detail        String?
  createdAt     DateTime          @default(now())

  application EnrollmentApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  actorUser   User?                 @relation("ApplicationActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([applicationId, createdAt])
  @@index([actorUserId])
}

model Enrollment {
  id                   String           @id @default(cuid())
  householdId          String
  childId              String
  tuitionPlanId        String
  sourceApplicationId  String?          @unique
  status               EnrollmentStatus @default(PENDING)
  startDate            DateTime
  endDate              DateTime?
  weeklyRateCents      Int
  monthlyRateCents     Int
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt

  household         Household              @relation(fields: [householdId], references: [id], onDelete: Cascade)
  child             Child                  @relation(fields: [childId], references: [id], onDelete: Cascade)
  tuitionPlan       TuitionPlan            @relation(fields: [tuitionPlanId], references: [id], onDelete: Restrict)
  sourceApplication EnrollmentApplication? @relation("EnrollmentSource", fields: [sourceApplicationId], references: [id], onDelete: SetNull)
  invoiceLineItems  InvoiceLineItem[]

  @@index([householdId])
  @@index([status])
  @@index([startDate])
}

model Invoice {
  id                    String        @id @default(cuid())
  householdId           String
  createdByUserId       String?
  sourceApplicationId   String?
  invoiceNumber         String        @unique
  status                InvoiceStatus @default(OPEN)
  issueDate             DateTime
  dueDate               DateTime
  periodStart           DateTime
  periodEnd             DateTime
  subtotalCents         Int
  taxCents              Int           @default(0)
  totalCents            Int
  paidCents             Int           @default(0)
  currency              String        @default("usd")
  isDeposit             Boolean       @default(false)
  stripeInvoiceId       String?
  stripePaymentIntentId String?
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt

  household         Household              @relation(fields: [householdId], references: [id], onDelete: Cascade)
  createdBy         User?                  @relation("InvoiceCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)
  sourceApplication EnrollmentApplication? @relation(fields: [sourceApplicationId], references: [id], onDelete: SetNull)
  lineItems         InvoiceLineItem[]
  payments          Payment[]

  @@unique([householdId, periodStart, periodEnd, isDeposit])
  @@index([householdId, status])
  @@index([sourceApplicationId])
}

model InvoiceLineItem {
  id               String    @id @default(cuid())
  invoiceId        String
  enrollmentId     String?
  tuitionPlanId    String?
  description      String
  quantity         Int       @default(1)
  unitAmountCents  Int
  totalCents       Int
  serviceStartDate DateTime?
  serviceEndDate   DateTime?
  createdAt        DateTime  @default(now())

  invoice     Invoice     @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  enrollment  Enrollment? @relation(fields: [enrollmentId], references: [id], onDelete: SetNull)
  tuitionPlan TuitionPlan? @relation(fields: [tuitionPlanId], references: [id], onDelete: SetNull)

  @@index([invoiceId])
  @@index([enrollmentId])
}

model PaymentMethod {
  id                    String            @id @default(cuid())
  householdId           String
  createdByUserId       String?
  stripePaymentMethodId String            @unique
  brand                 String?
  last4                 String?
  expMonth              Int?
  expYear               Int?
  type                  PaymentMethodType @default(CARD)
  isDefault             Boolean           @default(false)
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt

  household Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  createdBy User?     @relation("PaymentMethodCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)
  payments  Payment[]

  @@index([householdId, isDefault])
}

model Payment {
  id                    String        @id @default(cuid())
  invoiceId             String
  householdId           String
  paymentMethodId       String?
  createdByUserId       String?
  amountCents           Int
  currency              String        @default("usd")
  status                PaymentStatus @default(PENDING)
  stripePaymentIntentId String?
  stripeChargeId        String?
  failureReason         String?
  paidAt                DateTime?
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt

  invoice       Invoice        @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  household     Household      @relation(fields: [householdId], references: [id], onDelete: Cascade)
  paymentMethod PaymentMethod? @relation(fields: [paymentMethodId], references: [id], onDelete: SetNull)
  createdBy     User?          @relation("PaymentActor", fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@index([invoiceId, status])
  @@index([householdId, createdAt])
  @@index([stripePaymentIntentId])
}

model AdminInvite {
  id              String      @id @default(cuid())
  email           String
  tokenHash       String      @unique
  role            UserRole    @default(ADMIN)
  status          InviteStatus @default(PENDING)
  invitedByUserId String
  expiresAt       DateTime
  acceptedAt      DateTime?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  invitedBy User @relation("InviteSender", fields: [invitedByUserId], references: [id], onDelete: Cascade)

  @@index([email, status])
}

model AuditLog {
  id          String   @id @default(cuid())
  actorUserId String?
  action      String
  entityType  String
  entityId    String
  metadata    Json?
  createdAt   DateTime @default(now())

  actorUser User? @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId])
  @@index([action, createdAt])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}
