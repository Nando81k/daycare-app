generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  PARENT
  ADMIN
  TEACHER
}

enum EnrollmentLeadType {
  WAITLIST
  CONTACT
}

enum EnrollmentLeadStage {
  CONTACTED
  APPLICATION_SENT
  ACCEPTED
  DENIED
}

enum EnrollmentLeadPriority {
  HIGH
  MEDIUM
  NORMAL
  LOW
}

enum WaitlistStatus {
  REVIEW
  OFFER_READY
  LONG_RANGE
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  SCHEDULED
}

enum InvoiceStatus {
  DRAFT
  OPEN
  PAID
  PARTIALLY_PAID
  FAILED
  REFUNDED
  VOID
}

enum EnrollmentApplicationStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  APPROVED
  REJECTED
  WAITLISTED
}

enum FeeRuleKind {
  REGISTRATION
  MATERIALS
  LATE
  OTHER
}

enum PaymentStatus {
  PAID
  PROCESSING
  FAILED
}

enum DocumentStatus {
  REQUIRED
  SUBMITTED
  APPROVED
  EXPIRED
}

enum AnnouncementStatus {
  SCHEDULED
  DRAFT
  PUBLISHED
}

enum EventCategory {
  CLASSROOM
  FAMILY
  CLOSURE
  BILLING
}

enum MessageThreadStatus {
  ACTIVE
  RESPONSE_NEEDED
  CLOSED
}

enum MessageAuthorRole {
  STAFF
  PARENT
  DIRECTOR
}

enum StaffStatus {
  SCHEDULED
  COVERAGE_NEEDED
  OUT
}

model User {
  id                        String                  @id @default(cuid())
  email                     String                  @unique
  passwordHash              String
  name                      String
  role                      UserRole
  mustSetPassword           Boolean                 @default(false)
  passwordChangedAt         DateTime?
  lastSignedInAt            DateTime?
  twoFactorSecret           String?
  twoFactorEnabledAt        DateTime?
  parentProfile             ParentProfile?
  staffProfile              StaffProfile?
  adminProfile              AdminProfile?
  enrollmentDecisions       EnrollmentApplication[] @relation("EnrollmentApplicationDecider")
  sessions                  Session[]
  messages                  Message[]
  auditLogs                 AuditLog[]
  receivedInvites           AccountInviteToken[]    @relation("InviteRecipient")
  issuedInvites             AccountInviteToken[]    @relation("InviteIssuer")
  passwordResetTokens       PasswordResetToken[]
  uploadedDailyReportPhotos DailyReportPhoto[]      @relation("DailyReportPhotoUploader")
  authoredFamilyNotes       FamilyNote[]
  createdAt                 DateTime                @default(now())
  updatedAt                 DateTime                @updatedAt
}

model Session {
  id             String   @id @default(cuid())
  tokenHash      String   @unique
  userId         String
  expiresAt      DateTime
  lastAccessedAt DateTime @default(now())
  userAgent      String?
  ipAddress      String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Family {
  id              String                      @id @default(cuid())
  familyName      String
  enrollmentStage String
  parents         ParentProfile[]
  children        Child[]
  invoices        Invoice[]
  payments        Payment[]
  documents       Document[]
  messageThreads  MessageThread[]
  leads           EnrollmentLead[]
  applications    EnrollmentApplication[]
  subscriptions   StripeSubscriptionMapping[]
  billingProfile  FamilyBillingProfile?
  notes           FamilyNote[]
  createdAt       DateTime                    @default(now())
  updatedAt       DateTime                    @updatedAt
}

model FamilyNote {
  id        String   @id @default(cuid())
  familyId  String
  authorId  String
  body      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  family    Family   @relation(fields: [familyId], references: [id], onDelete: Cascade)
  author    User     @relation(fields: [authorId], references: [id])

  @@index([familyId, createdAt])
}

model ParentProfile {
  id                      String                  @id @default(cuid())
  userId                  String                  @unique
  familyId                String
  phone                   String
  billingContact          String
  pickupPolicy            String
  notificationPreferences Json
  user                    User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  family                  Family                  @relation(fields: [familyId], references: [id], onDelete: Cascade)
  children                ParentChild[]
  applications            EnrollmentApplication[]
  createdAt               DateTime                @default(now())
  updatedAt               DateTime                @updatedAt
}

model ParentChild {
  parentProfileId String
  childId         String
  relationship    String
  parentProfile   ParentProfile @relation(fields: [parentProfileId], references: [id], onDelete: Cascade)
  child           Child         @relation(fields: [childId], references: [id], onDelete: Cascade)

  @@id([parentProfileId, childId])
}

model Classroom {
  id              String          @id @default(cuid())
  slug            String          @unique
  name            String          @unique
  ageGroup        String
  capacity        Int
  leadTeacherName String
  ratioLabel      String
  nextEvent       String
  note            String
  children        Child[]
  staffProfiles   StaffProfile[]
  calendarEvents  CalendarEvent[]
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
}

model Child {
  id                String             @id @default(cuid())
  slug              String             @unique
  familyId          String
  classroomId       String
  firstName         String
  lastName          String
  ageLabel          String
  birthday          DateTime
  teacherLabel      String
  summary           String
  allergies         Json
  medicalNotes      Json
  comfortNotes      Json
  family            Family             @relation(fields: [familyId], references: [id], onDelete: Cascade)
  classroom         Classroom          @relation(fields: [classroomId], references: [id], onDelete: Cascade)
  emergencyContacts EmergencyContact[]
  authorizedPickups AuthorizedPickup[]
  attendanceRecords AttendanceRecord[]
  dailyReports      DailyReport[]
  documents         Document[]
  parentLinks       ParentChild[]
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
}

model EmergencyContact {
  id           String @id @default(cuid())
  childId      String
  name         String
  relationship String
  phone        String
  priority     String
  child        Child  @relation(fields: [childId], references: [id], onDelete: Cascade)
}

model AuthorizedPickup {
  id           String  @id @default(cuid())
  childId      String
  name         String
  relationship String
  phone        String
  note         String?
  child        Child   @relation(fields: [childId], references: [id], onDelete: Cascade)
}

model DailyReport {
  id          String             @id @default(cuid())
  childId     String
  date        DateTime
  arrivalMood String
  summary     String
  meals       Json
  rest        Json
  activities  Json
  staffNotes  Json
  child       Child              @relation(fields: [childId], references: [id], onDelete: Cascade)
  photoAssets DailyReportPhoto[]

  @@unique([childId, date])
}

model DailyReportPhoto {
  id               String      @id @default(cuid())
  dailyReportId    String
  title            String
  caption          String?
  fileName         String
  blobPathname     String
  blobUrl          String
  blobDownloadUrl  String
  contentType      String
  sizeBytes        Int
  uploadedByUserId String?
  dailyReport      DailyReport @relation(fields: [dailyReportId], references: [id], onDelete: Cascade)
  uploadedByUser   User?       @relation("DailyReportPhotoUploader", fields: [uploadedByUserId], references: [id], onDelete: SetNull)
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
}

model AttendanceRecord {
  id         String           @id @default(cuid())
  childId    String
  date       DateTime
  status     AttendanceStatus
  checkInAt  DateTime?
  checkOutAt DateTime?
  note       String
  child      Child            @relation(fields: [childId], references: [id], onDelete: Cascade)

  @@unique([childId, date])
}

model MessageThread {
  id             String              @id @default(cuid())
  familyId       String
  subject        String
  classroomLabel String
  status         MessageThreadStatus
  participants   Json
  lastMessageAt  DateTime
  family         Family              @relation(fields: [familyId], references: [id], onDelete: Cascade)
  messages       Message[]
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
}

model Message {
  id           String            @id @default(cuid())
  threadId     String
  authorUserId String?
  senderName   String
  role         MessageAuthorRole
  body         String
  sentAt       DateTime          @default(now())
  thread       MessageThread     @relation(fields: [threadId], references: [id], onDelete: Cascade)
  authorUser   User?             @relation(fields: [authorUserId], references: [id], onDelete: SetNull)
}

model Invoice {
  id                      String                     @id @default(cuid())
  familyId                String
  label                   String
  description             String?
  amountCents             Int
  dueDate                 DateTime
  paidAt                  DateTime?
  status                  InvoiceStatus
  stripePaymentIntentId   String?                    @unique
  stripeCheckoutSessionId String?                    @unique
  /// Forward-compat link to a future Stripe Subscription (set in Phase 5+).
  subscriptionId          String?
  /// Optional reference to the FeeRule that generated this invoice.
  feeRuleId               String?
  family                  Family                     @relation(fields: [familyId], references: [id], onDelete: Cascade)
  feeRule                 FeeRule?                   @relation(fields: [feeRuleId], references: [id], onDelete: SetNull)
  subscription            StripeSubscriptionMapping? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
  payments                Payment[]
  createdAt               DateTime                   @default(now())
  updatedAt               DateTime                   @updatedAt
}

model Payment {
  id                    String        @id @default(cuid())
  familyId              String
  invoiceId             String?
  label                 String
  amountCents           Int
  method                String
  status                PaymentStatus
  paidAt                DateTime
  processedAt           DateTime?
  stripePaymentIntentId String?       @unique
  stripePaymentMethodId String?
  receiptUrl            String?
  failureReason         String?
  family                Family        @relation(fields: [familyId], references: [id], onDelete: Cascade)
  invoice               Invoice?      @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  createdAt             DateTime      @default(now())
}

model FamilyBillingProfile {
  id                        String  @id @default(cuid())
  familyId                  String  @unique
  stripeCustomerId          String? @unique
  defaultPaymentMethodId    String?
  defaultPaymentMethodBrand String?
  defaultPaymentMethodLast4 String?
  defaultPaymentMethodLabel String?

  lastPaymentError String?
  family           Family   @relation(fields: [familyId], references: [id], onDelete: Cascade)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model Document {
  id              String         @id @default(cuid())
  familyId        String
  childId         String?
  title           String
  category        String
  owner           String
  status          DocumentStatus
  dueDate         DateTime?
  note            String
  fileName        String?
  blobPathname    String?
  blobUrl         String?
  blobDownloadUrl String?
  contentType     String?
  sizeBytes       Int?
  submittedAt     DateTime?
  approvedAt      DateTime?
  reviewedByName  String?

  // admin-uploaded blank template (separate from the parent's submission blob fields)
  templateBlobPathname String?
  templateBlobUrl      String?
  templateDownloadUrl  String?
  templateFileName     String?
  templateContentType  String?
  templateSizeBytes    Int?

  // typed-signature record (no blob). signedName + signedAt populated when a
  // parent uses the in-app type-to-sign flow instead of uploading a scan.
  signedName String?
  signedAt   DateTime?
  signedIp   String?

  family          Family         @relation(fields: [familyId], references: [id], onDelete: Cascade)
  child           Child?         @relation(fields: [childId], references: [id], onDelete: SetNull)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
}

model EnrollmentLead {
  id              String                 @id @default(cuid())
  familyId        String?
  parentName      String
  familyName      String
  email           String
  phone           String
  childName       String
  childAgeLabel   String
  requestedStart  String
  programInterest String
  source          String
  leadType        EnrollmentLeadType
  stage           EnrollmentLeadStage
  priority        EnrollmentLeadPriority
  assignedTo      String
  note            String
  scheduleNeed    String?
  waitlistStatus  WaitlistStatus?
  referralSource  String?
  family          Family?                @relation(fields: [familyId], references: [id], onDelete: SetNull)
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt
}

model StaffProfile {
  id            String      @id @default(cuid())
  userId        String?     @unique
  classroomId   String?
  name          String
  roleLabel     String
  certification String
  status        StaffStatus
  note          String
  user          User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  classroom     Classroom?  @relation(fields: [classroomId], references: [id], onDelete: SetNull)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
}

model Announcement {
  id            String             @id @default(cuid())
  title         String
  audience      String
  publishStatus AnnouncementStatus
  scheduledFor  DateTime?
  publishedAt   DateTime?
  summary       String
  body          String?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
}

model CalendarEvent {
  id          String        @id @default(cuid())
  classroomId String?
  title       String
  date        DateTime
  timeLabel   String
  category    EventCategory
  description String
  classroom   Classroom?    @relation(fields: [classroomId], references: [id], onDelete: Cascade)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
}

model SchoolSetting {
  id                 String   @id @default(cuid())
  sectionKey         String
  sectionTitle       String
  sectionDescription String
  label              String
  value              String
  note               String?
  sortOrder          Int      @default(0)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

model AccountInviteToken {
  id             String    @id @default(cuid())
  tokenHash      String    @unique
  userId         String
  email          String
  role           UserRole
  expiresAt      DateTime
  acceptedAt     DateTime?
  issuedByUserId String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  user           User      @relation("InviteRecipient", fields: [userId], references: [id], onDelete: Cascade)
  issuedByUser   User?     @relation("InviteIssuer", fields: [issuedByUserId], references: [id], onDelete: SetNull)
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  userId    String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AuditLog {
  id          String   @id @default(cuid())
  actorUserId String?
  action      String
  subjectType String
  subjectId   String?
  details     Json?
  createdAt   DateTime @default(now())
  actorUser   User?    @relation(fields: [actorUserId], references: [id], onDelete: SetNull)
}

/**
 * ------------------------------------------------------------------
 */
/**
 * Programs, Schedules & Pricing
 */
/**
 * ------------------------------------------------------------------
 */

model Program {
  id           String                  @id @default(cuid())
  slug         String                  @unique
  name         String                  @unique
  ageRange     String?
  description  String?
  sortOrder    Int                     @default(0)
  isActive     Boolean                 @default(true)
  createdAt    DateTime                @default(now())
  updatedAt    DateTime                @updatedAt
  rates        ProgramRate[]
  applications EnrollmentApplication[]
  feeRules     FeeRule[]
}

model Schedule {
  id              String                  @id @default(cuid())
  slug            String                  @unique
  name            String                  @unique
  daysDescription String?
  sortOrder       Int                     @default(0)
  isActive        Boolean                 @default(true)
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt
  rates           ProgramRate[]
  applications    EnrollmentApplication[]
}

model ProgramRate {
  id           String   @id @default(cuid())
  programId    String
  scheduleId   String
  rateCents    Int
  billingLabel String?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  program      Program  @relation(fields: [programId], references: [id], onDelete: Cascade)
  schedule     Schedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)

  @@unique([programId, scheduleId])
}

/**
 * ------------------------------------------------------------------
 */
/**
 * Enrollment Applications (Phase 5)
 */
/**
 * ------------------------------------------------------------------
 */

model EnrollmentApplication {
  id                    String                      @id @default(cuid())
  familyId              String?
  parentProfileId       String?
  childFirstName        String
  childLastName         String
  dateOfBirth           String
  childAgeLabel         String
  primaryLanguage       String
  homeAddress           String
  /// Guardian snapshot at submission time.
  parentName            String
  parentEmail           String
  parentPhone           String
  relationshipToChild   String
  emergencyContactName  String
  emergencyContactPhone String
  /// Program/schedule selection — slugs and ids both stored.
  programId             String?
  scheduleId            String?
  programSlug           String
  scheduleSlug          String
  preferredStartDate    String
  /// Health & safety
  pediatricianName      String
  pediatricianPhone     String
  healthNotes           String
  /// Free-form flexible payload (consents, authorized pickups, etc.).
  payload               Json
  status                EnrollmentApplicationStatus @default(DRAFT)
  /// Internal review fields
  internalNote          String                      @default("")
  decisionNote          String?
  submittedAt           DateTime?
  decidedAt             DateTime?
  decidedByUserId       String?
  family                Family?                     @relation(fields: [familyId], references: [id], onDelete: SetNull)
  parentProfile         ParentProfile?              @relation(fields: [parentProfileId], references: [id], onDelete: SetNull)
  program               Program?                    @relation(fields: [programId], references: [id], onDelete: SetNull)
  schedule              Schedule?                   @relation(fields: [scheduleId], references: [id], onDelete: SetNull)
  decidedByUser         User?                       @relation("EnrollmentApplicationDecider", fields: [decidedByUserId], references: [id], onDelete: SetNull)
  createdAt             DateTime                    @default(now())
  updatedAt             DateTime                    @updatedAt

  @@index([familyId, status])
  @@index([status, updatedAt])
}

/**
 * ------------------------------------------------------------------
 */
/**
 * Fee rules (Phase 5)
 */
/**
 * ------------------------------------------------------------------
 */

model FeeRule {
  id          String      @id @default(cuid())
  kind        FeeRuleKind
  label       String
  description String?
  amountCents Int
  currency    String      @default("NGN")
  isActive    Boolean     @default(true)
  /// When set, the fee only applies to enrollments in this specific program.
  programId   String?
  program     Program?    @relation(fields: [programId], references: [id], onDelete: SetNull)
  invoices    Invoice[]
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
}

/**
 * ------------------------------------------------------------------
 */
/**
 * Stripe Subscription mappings (forward-compat seam, Phase 5)
 */
/**
 * ------------------------------------------------------------------
 */

model StripeSubscriptionMapping {
  id                   String    @id @default(cuid())
  familyId             String
  stripeSubscriptionId String    @unique
  stripeCustomerId     String?
  productLabel         String?
  status               String
  currentPeriodEnd     DateTime?
  metadata             Json?
  family               Family    @relation(fields: [familyId], references: [id], onDelete: Cascade)
  invoices             Invoice[]
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  @@index([familyId])
}

/**
 * ------------------------------------------------------------------
 */
/**
 * Admin profile (Phase 5)
 */
/**
 * ------------------------------------------------------------------
 */

model AdminProfile {
  id          String   @id @default(cuid())
  userId      String   @unique
  title       String   @default("")
  permissions Json
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
