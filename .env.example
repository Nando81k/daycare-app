# ──────────────────────────────────────────────────────────────────────────
# Ambassadors Care — environment configuration
# Copy to `.env` (dev) or set as project env vars in your hosting provider.
# ──────────────────────────────────────────────────────────────────────────

# ─── Core ────────────────────────────────────────────────────────────────
NODE_ENV="development"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ─── Database (Postgres / Neon) ──────────────────────────────────────────
# Production: use a separate Neon branch with point-in-time recovery enabled.
# The connection string MUST be a bare URL (no `psql ` prefix or quotes).
DATABASE_URL="postgresql://user:password@host/database?sslmode=verify-full"

# ─── Auth ────────────────────────────────────────────────────────────────
# Generate with: `openssl rand -hex 48`. NEVER ship the dev fallback to prod.
SESSION_SECRET="replace-me-with-a-long-random-string"

# ─── Storage (Vercel Blob) ───────────────────────────────────────────────
# Required for file uploads (documents, daily report photos).
BLOB_READ_WRITE_TOKEN=""

# ─── Billing (Paystack) ──────────────────────────────────────────────────
# Use sk_test_... locally. In production swap to sk_live_... once Paystack
# completes their compliance review on your account.
# Register a webhook in the Paystack dashboard pointing at:
#   https://www.<your-domain>/api/paystack/webhook
# subscribed to charge.success (other events optional).
PAYSTACK_SECRET_KEY=""
# Currency — Paystack defaults to NGN. Override with USD/GHS/ZAR/KES if
# you've enabled multi-currency on your Paystack account.
PAYSTACK_CURRENCY="NGN"

# ─── Email (Resend) ──────────────────────────────────────────────────────
# Production: verify your sending domain in Resend (SPF + DKIM + DMARC).
# Without a verified domain, password-reset and invite emails silently no-op.
RESEND_API_KEY=""
RESEND_FROM_EMAIL="Ambassadors Care <hello@ambassadorscare.com>"

# ─── CAPTCHA (Cloudflare Turnstile) ──────────────────────────────────────
# Protects every public form: signup, login, password-reset request,
# /contact, /waitlist. Without these, those forms accept all submissions
# (development behavior). REQUIRED in production. Keys at https://dash.cloudflare.com/
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""

# ─── Persistent rate limiting (Upstash Redis) ────────────────────────────
# Without these, rate-limit buckets live in per-instance memory — fine for
# a single dev server, defeated by horizontal scaling on Vercel. Set both
# in production so login / signup / password-reset / waitlist throttles
# share state across all replicas. Provision at https://console.upstash.com/
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# ─── Error tracking (Sentry) ─────────────────────────────────────────────
# Without a DSN, Sentry is a no-op. STRONGLY recommended for production —
# unhandled errors in server actions otherwise die in console. Server DSN
# catches API/server-action errors, public DSN catches browser errors.
# Same project = same DSN value is fine.
SENTRY_DSN=""
NEXT_PUBLIC_SENTRY_DSN=""

# ─── Cron (internal scheduled jobs) ──────────────────────────────────────
# Used by Vercel Cron / GitHub Actions to authenticate scheduled job invocations.
# Generate with: `openssl rand -hex 32`.
CRON_SECRET="replace-me-with-a-long-random-string"

# ─── Healthcheck ─────────────────────────────────────────────────────────
# GET /api/health returns 200 + JSON when the database round-trips, 503 on
# failure. The `services` block surfaces which integrations are configured
# (no secrets are leaked). Point your uptime monitor at this URL.
# No env var needed — endpoint is always live.
