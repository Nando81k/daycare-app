# Environment Variables - Example (Copy to .env.local and fill in actual values)

# NextAuth Configuration (REQUIRED)
NEXTAUTH_SECRET=your-secret-key-min-32-chars-generate-with-openssl-rand
NEXTAUTH_URL=http://localhost:3000

# Database (REQUIRED)
DATABASE_URL=postgresql://user:password@localhost:5432/daycare_db

# Field-level encryption for sensitive identity data (REQUIRED for intake enrollment submissions)
# 32-byte key as base64 OR 64-char hex.
FIELD_ENCRYPTION_KEY=

# Payment Provider
# Keep disconnected until Stripe is ready; set to stripe when credentials are available.
PAYMENT_PROVIDER=disconnected

# Stripe Billing (Required only when PAYMENT_PROVIDER=stripe)
# Use test-mode keys locally so the app can validate Stripe auth, portal readiness, and checkout sessions.
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxx
# Optional: pin to a specific Stripe Customer Portal configuration
STRIPE_BILLING_PORTAL_CONFIGURATION=bpc_xxx

# Child Photo Uploads (S3-compatible object storage)
S3_BUCKET=ambassadors-care-assets
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=your-access-key-id
S3_SECRET_ACCESS_KEY=your-secret-access-key
# Optional for S3-compatible providers (Cloudflare R2, MinIO, etc.)
S3_ENDPOINT=
S3_FORCE_PATH_STYLE=false

# Email Delivery (Optional for local dev, required for transactional emails)
RESEND_API_KEY=re_xxx
RESEND_FROM_EMAIL=notifications@ambassadorscare.com

# SMS Delivery via Twilio (Optional for local dev, required for parent SMS notifications)
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_FROM_PHONE=+15551234567

# Logging/Monitoring (Optional)
LOG_LEVEL=info
